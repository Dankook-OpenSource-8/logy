# Local backend API
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/logy_local

# Use a separate Supabase project for local testing if uploads/auth/storage are needed.
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_KEY=your-test-service-or-anon-key
SUPABASE_VIDEO_BUCKET=videos

# Optional: run the OCR server locally and point the backend at it.
# Leave this empty to let the backend call EasyOCR directly.
OCR_SERVER_URL=http://127.0.0.1:8001/ocr
OCR_SERVER_TIMEOUT_SECONDS=45

# Model loading
CLIP_LOCAL_FILES_ONLY=false
STUDY_CLASSIFIER_LOCAL_FILES_ONLY=false
STUDY_CLASSIFIER_MODEL_PATH=models/study_classifier.pt
